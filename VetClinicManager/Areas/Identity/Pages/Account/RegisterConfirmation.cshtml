@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Check your email";
}

<div class="container d-flex align-items-center" style="min-height: 80vh;">
    <div class="row justify-content-center w-100">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body p-5">
                    @if (Model.DisplayConfirmAccountLink)
                    {
                        <i class="bi bi-envelope-check text-warning" style="font-size: 3rem;"></i>
                        <h4 class="mt-3">Confirm your account</h4>
                        <p class="text-muted mt-2">
                            No email sender configured. Click the link below to confirm your account manually.
                        </p>
                        <a href="@Model.EmailConfirmationUrl" class="btn btn-primary d-block w-auto mx-4 mt-2">
                            Click here to confirm your account
                        </a>
                    }
                    else
                    {
                        <i class="bi bi-envelope-check text-success" style="font-size: 3rem;"></i>
                        <h4 class="mt-3">Check your email</h4>
                        <p class="text-muted mt-2">
                            We've sent a confirmation link to <strong>@Model.Email</strong>.
                            Please check your inbox and click the link to activate your account.
                        </p>
                        <hr />
                        <p class="text-muted small">
                            Didn't receive the email? Check your spam folder.
                        </p>
                    }
                    <a asp-page="./Login" class="btn btn-outline-secondary mt-3">Back to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>